{
  "name": "codex-spec",
  "version": "2.0.0",
  "description": "Spec-driven development for Codex: readable specs, acceptance checks, and reviewable evidence.",
  "type": "module",
  "bin": {
    "codex-spec": "bin/codex-spec.mjs"
  },
  "files": [
    "bin/",
    ".agents/skills/spec-driven-development/",
    "docs/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "scripts/demo.mjs",
    "examples/",
    "DEMO.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "check:bundle": "node scripts/build.mjs --check",
    "demo": "node scripts/demo.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/smoke-package.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "marked": "18.2.0",
    "shell-quote": "1.12.0",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shenli/codex-spec.git"
  }
}
